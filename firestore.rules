rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Funciones Auxiliares de Autenticación y Matriz RBAC
    // =========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'colaborador');
    }

    function getUserTeamId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId
        : null;
    }

    function isTI() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'TI' || r == 'ti');
    }

    function isGerente() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Gerente' || r == 'gerente' || r == 'Socio' || r == 'socio' || isTI());
    }

    function isSupervisor() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Supervisor' || r == 'supervisor' || isGerente());
    }

    function isEmpleado() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Empleado' || r == 'empleado' || r == 'Colaborador' || r == 'colaborador');
    }

    function isRH() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'RH' || r == 'rh');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDemoAccount() {
      return request.auth.token.email != null && (
        request.auth.token.email.matches('.*\\.prueba@russellbedford\\.mx') ||
        request.auth.token.email == 'ti.root@russellbedford.mx'
      );
    }

    // Prohibición estricta de imágenes faciales base64/URLs; solo vector numérico 128-D
    function hasNoBiometricImages(data) {
      return !('enrolledFacePhoto' in data) &&
             !('facePhotoUrl' in data) &&
             (!('faceDescriptor' in data) || data.faceDescriptor == null || (data.faceDescriptor is list && data.faceDescriptor.size() == 128)) &&
             (!('biometrics' in data) || data.biometrics == null || (
               !('photo' in data.biometrics) &&
               !('image' in data.biometrics) &&
               !('base64' in data.biometrics)
             ));
    }

    // =========================================================
    // 1. Colección `users`
    //    - Solo TI puede modificar `role` y `modules`
    //    - Cada usuario lee su propio perfil y actualiza únicamente
    //      su `faceDescriptor` (128 floats, nunca imágenes) o datos básicos
    //    - RH tiene solo lectura básica de personal
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isSupervisor() ||
        isOwner(userId) ||
        isDemoAccount() ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid)
      );

      allow create: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        isDemoAccount() ||
        isOwner(userId)
      );

      allow update: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules'])) ||
        (isDemoAccount() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules']))
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 2. Colección `companies` y `clients` (Empresas / Clientes)
    //    - Lectura y creación: TI, Socio, Gerente y Supervisor
    //    - Acceso estrictamente DENEGADO para RH
    // =========================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated() && !isRH() && (isTI() || isSupervisor() || isDemoAccount());
      allow create, update: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
      allow delete: if isAuthenticated() && !isRH() && (isTI() || isGerente());
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && !isRH() && (isTI() || isSupervisor() || isDemoAccount());
      allow create, update: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
      allow delete: if isAuthenticated() && !isRH() && (isTI() || isGerente());
    }

    // =========================================================
    // 3. Colección `tasks` (Tareas y Tiempos en minutos enteros)
    //    - Lectura/escritura según asignación de equipo/supervisor
    //    - Acceso estrictamente DENEGADO para RH
    // =========================================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        isGerente() ||
        (isSupervisor() && (
          resource.data.supervisorId == request.auth.uid ||
          resource.data.created_by == request.auth.uid ||
          isDemoAccount()
        )) ||
        (isEmpleado() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assigned_to == request.auth.uid
        ))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isTI() ||
        isSupervisor() ||
        (isEmpleado() && (
          request.resource.data.assignedTo == request.auth.uid ||
          request.resource.data.assigned_to == request.auth.uid
        ))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isTI() ||
        isSupervisor() ||
        (isEmpleado() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assigned_to == request.auth.uid
        ))
      );

      allow delete: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
    }

    // =========================================================
    // 4. Colección `projects` - BLOQUEO TOTAL A RH
    // =========================================================
    match /projects/{projectId} {
      allow read: if isAuthenticated() && !isRH();
      allow write: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
    }

    // =========================================================
    // 5. Colección `attendance` (Asistencias y Biometría)
    //    - Colaborador crea/actualiza sus propios registros
    //    - Supervisor lee su equipo
    //    - RH y TI tienen lectura global consolidada
    // =========================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isGerente() ||
        (isSupervisor() && (resource.data.teamId == getUserTeamId() || isDemoAccount())) ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );

      allow update: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 6. Registros de Tiempo Legacy (`checkins` y `time_logs`)
    // =========================================================
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isTI() || isRH() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
      allow write: if isAuthenticated() && (
        isTI() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
    }

    match /time_logs/{logId} {
      allow read: if isAuthenticated() && (
        isTI() || isRH() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
      allow write: if isAuthenticated() && !isRH() && (
        isTI() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
    }

    // =========================================================
    // 7. Invitaciones, Equipos, Timers, Notificaciones y Auditoría
    // =========================================================
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (isTI() || isSupervisor());
      allow update: if true;
      allow delete: if isAuthenticated() && (isTI() || isSupervisor());
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isTI() || isSupervisor() || isDemoAccount());
    }

    match /active_timers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isOwner(userId) || isTI() || isSupervisor() || isDemoAccount()
      );
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        resource.data.recipient_id == request.auth.uid ||
        resource.data.sender_id == request.auth.uid ||
        isDemoAccount()
      );
      allow create: if isAuthenticated() && !isRH();
      allow update, delete: if isAuthenticated() && (
        resource.data.recipient_id == request.auth.uid || isTI()
      );
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isTI() || isGerente() || isRH() || isDemoAccount());
      allow write: if isAuthenticated();
    }
  }
}
