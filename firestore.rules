rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Arquitectura Multi-Equipo RBAC para Producción
    // Nivel 0: TI (Root - Administración Global)
    // Nivel 1: Socio (Dirección - Visibilidad Global Multi-Equipo)
    // Nivel 2: Gerente (Aislado a sus teamIds / gerenteId) || RH (Lateral - Solo Asistencias/Tiempos)
    // Nivel 3: Supervisor (Aislado a sus teamIds / supervisorId)
    // Nivel 4: Colaborador (Aislado a assignedToIds / assignedToId / propios registros)
    //
    // Optimización Zero-Read / Máx. 1 get():
    // - Prioriza Custom Claims (`request.auth.token.role`, `request.auth.token.teamIds`)
    // - Máximo 1 lectura cacheada a `users/{uid}` vía `getUserData()`
    // - Compatibilidad temporal controlada con cuentas `demo_*` durante pruebas
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function safeLower(val) {
      return val is string ? val.lower() : '';
    }

    function getAuthEmailLower() {
      return isAuthenticated() && 'email' in request.auth.token
        ? safeLower(request.auth.token.email)
        : '';
    }

    // Compatibilidad temporal para cuentas demo de prueba (usuarios reales usan estrictamente request.auth.uid)
    function getDemoDocIdByEmail() {
      let em = getAuthEmailLower();
      return em == 'ti.root@russellbedford.mx' ? 'demo_ti'
        : em == 'socio.prueba@russellbedford.mx' ? 'demo_socio'
        : em == 'gerente.prueba@russellbedford.mx' ? 'demo_gerente'
        : em == 'rh.prueba@russellbedford.mx' ? 'demo_rh'
        : em == 'supervisor.prueba@russellbedford.mx' ? 'demo_supervisor'
        : em == 'colaborador.prueba@russellbedford.mx' ? 'demo_colaborador'
        : '';
    }

    function getDemoRoleByEmail() {
      let em = getAuthEmailLower();
      return em == 'ti.root@russellbedford.mx' ? 'ti'
        : em == 'socio.prueba@russellbedford.mx' ? 'socio'
        : em == 'gerente.prueba@russellbedford.mx' ? 'gerente'
        : em == 'rh.prueba@russellbedford.mx' ? 'rh'
        : em == 'supervisor.prueba@russellbedford.mx' ? 'supervisor'
        : em == 'colaborador.prueba@russellbedford.mx' ? 'colaborador'
        : '';
    }

    function isDemoAccount() {
      return getDemoDocIdByEmail() != '';
    }

    function getEffectiveUid() {
      let demoId = getDemoDocIdByEmail();
      return demoId != '' ? demoId : request.auth.uid;
    }

    // Máximo 1 único `get()` por petición (Firestore cachea el documento dentro del request)
    function getUserData() {
      let uidPath = getEffectiveUid();
      return exists(/databases/$(database)/documents/users/$(uidPath))
        ? get(/databases/$(database)/documents/users/$(uidPath)).data
        : {};
    }

    // Resuelve el rol con 0 lecturas vía Custom Claims o demo, y máx. 1 lectura en users/{uid}
    function getUserRoleLower() {
      let demoRole = getDemoRoleByEmail();
      return ('role' in request.auth.token && request.auth.token.role is string)
        ? request.auth.token.role.lower()
        : (demoRole != ''
            ? demoRole
            : safeLower(getUserData().get('role', 'colaborador')));
    }

    // Resuelve el arreglo multi-equipo `teamIds` del usuario autenticado
    function getUserTeamIds() {
      let demoRole = getDemoRoleByEmail();
      return ('teamIds' in request.auth.token && request.auth.token.teamIds is list)
        ? request.auth.token.teamIds
        : (demoRole != ''
            ? ['team-prueba-01']
            : (getUserData().get('teamIds', []) is list && getUserData().get('teamIds', []).size() > 0
                ? getUserData().get('teamIds', [])
                : (getUserData().get('teamId', '') is string && getUserData().get('teamId', '') != ''
                    ? [getUserData().get('teamId', '')]
                    : [])));
    }

    // Helpers de rol sin cascadas (máx. 1 evaluación de rol)
    function isTI() {
      return isAuthenticated() && getUserRoleLower() == 'ti';
    }

    function isSocio() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio'];
    }

    function isGerente() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio', 'gerente'];
    }

    function isGerenteOnly() {
      return isAuthenticated() && getUserRoleLower() == 'gerente';
    }

    function isSupervisor() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio', 'gerente', 'supervisor'];
    }

    function isSupervisorOnly() {
      return isAuthenticated() && getUserRoleLower() == 'supervisor';
    }

    function isRH() {
      return isAuthenticated() && getUserRoleLower() == 'rh';
    }

    function isColaborador() {
      return isAuthenticated() && getUserRoleLower() in ['empleado', 'colaborador'];
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        getEffectiveUid() == userId
      );
    }

    // Verifica si el documento comparte al menos un equipo con los `teamIds` del usuario
    function sharesAnyTeam(data) {
      let myTeams = getUserTeamIds();
      return data != null && myTeams.size() > 0 && (
        (data.get('teamIds', []) is list && myTeams.hasAny(data.get('teamIds', []))) ||
        (data.get('teamId', '') is string && data.get('teamId', '') in myTeams)
      );
    }

    function isManagedByGerente(data) {
      let effUid = getEffectiveUid();
      return data != null && (
        data.get('gerenteId', '') == request.auth.uid ||
        data.get('gerenteId', '') == effUid ||
        data.get('managerId', '') == request.auth.uid ||
        data.get('managerId', '') == effUid ||
        sharesAnyTeam(data)
      );
    }

    function isManagedBySupervisor(data) {
      let effUid = getEffectiveUid();
      return data != null && (
        data.get('supervisorId', '') == request.auth.uid ||
        data.get('supervisorId', '') == effUid ||
        data.get('supervisor_id', '') == request.auth.uid ||
        data.get('supervisor_id', '') == effUid ||
        data.get('leadUserId', '') == request.auth.uid ||
        data.get('leadUserId', '') == effUid ||
        data.get('created_by', '') == request.auth.uid ||
        data.get('created_by', '') == effUid ||
        sharesAnyTeam(data)
      );
    }

    function matchesUserRecord(data) {
      let effUid = getEffectiveUid();
      let em = getAuthEmailLower();
      return data != null && (
        data.get('userId', '') == request.auth.uid ||
        data.get('userId', '') == effUid ||
        (em != '' && safeLower(data.get('userEmail', '')) == em) ||
        (em != '' && safeLower(data.get('email', '')) == em)
      );
    }

    function isAssignedToProjectData(data) {
      let effUid = getEffectiveUid();
      let em = getAuthEmailLower();
      return data != null && (
        (data.get('assignedToIds', []) is list && (request.auth.uid in data.get('assignedToIds', []) || effUid in data.get('assignedToIds', []))) ||
        (data.get('assignedUserIds', []) is list && (request.auth.uid in data.get('assignedUserIds', []) || effUid in data.get('assignedUserIds', []))) ||
        (em != '' && data.get('assignedUserEmails', []) is list && em in data.get('assignedUserEmails', []))
      );
    }

    function isAssignedToTaskData(data) {
      let effUid = getEffectiveUid();
      let em = getAuthEmailLower();
      return data != null && (
        (data.get('assignedToIds', []) is list && (request.auth.uid in data.get('assignedToIds', []) || effUid in data.get('assignedToIds', []))) ||
        data.get('assignedToId', '') == request.auth.uid ||
        data.get('assignedToId', '') == effUid ||
        data.get('assignedTo', '') == request.auth.uid ||
        data.get('assignedTo', '') == effUid ||
        data.get('assigned_to', '') == request.auth.uid ||
        data.get('assigned_to', '') == effUid ||
        (em != '' && safeLower(data.get('assignedToEmail', '')) == em)
      );
    }

    // Prohibición estricta de imágenes faciales; solo vector numérico 128-D
    function hasNoBiometricImages(data) {
      return !('enrolledFacePhoto' in data) &&
             !('facePhotoUrl' in data) &&
             (!('faceDescriptor' in data) || data.faceDescriptor == null || (data.faceDescriptor is list && data.faceDescriptor.size() == 128)) &&
             (!('biometrics' in data) || data.biometrics == null || (
               !('photo' in data.biometrics) &&
               !('image' in data.biometrics) &&
               !('base64' in data.biometrics)
             ));
    }

    // =========================================================
    // 1. Colección `users/{uid}` (Multi-Equipo + Cadena de Mando)
    //    - ID de documento real = request.auth.uid (demo_* temporal en pruebas)
    //    - Guarda `teamIds` (array), `supervisorId`, `gerenteId`
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isSocio() ||
        isRH() ||
        isOwner(userId) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data)) ||
        (getAuthEmailLower() != '' && safeLower(resource.data.get('email', '')) == getAuthEmailLower())
      );

      allow create: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        isOwner(userId)
      );

      allow update: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        (isGerente() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules', 'hierarchyLevel'])) ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules', 'hierarchyLevel', 'teamIds', 'gerenteId']))
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 2. Colección `teams/{teamId}` (Estructura Multi-Equipo)
    //    - Campos: name, code, gerenteId, supervisorId, memberIds[], status
    //    - Escritura RESTRINGIDA exclusivamente a TI, Socio y Gerente
    //      (ni Supervisores ni Colaboradores ni RH pueden modificar equipos)
    // =========================================================
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        isSocio() ||
        isRH() ||
        teamId in getUserTeamIds() ||
        isManagedByGerente(resource.data) ||
        isManagedBySupervisor(resource.data) ||
        (resource.data.get('memberIds', []) is list && (request.auth.uid in resource.data.get('memberIds', []) || getEffectiveUid() in resource.data.get('memberIds', [])))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && (
          request.resource.data.get('gerenteId', '') == request.auth.uid ||
          request.resource.data.get('gerenteId', '') == getEffectiveUid()
        ))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && (
          resource.data.get('gerenteId', '') == request.auth.uid ||
          resource.data.get('gerenteId', '') == getEffectiveUid()
        ))
      );

      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    // =========================================================
    // 3. Colecciones `companies` y `clients` (Directorio Comercial)
    //    - RH: BLOQUEO ESTRICTO (false)
    //    - TI, Socio, Gerente: lectura y gestión completa
    //    - Supervisor / Colaborador: lectura operativa (nombre/logo en proyectos)
    // =========================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated() && !isRH();
      allow create, update: if isAuthenticated() && !isRH() && isGerente();
      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && !isRH();
      allow create, update: if isAuthenticated() && !isRH() && isGerente();
      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    // =========================================================
    // 4. Colección `projects/{projectId}` (Aislamiento Multi-Equipo)
    //    - RH: BLOQUEO ESTRICTO (false)
    //    - TI / Socio: Global
    //    - Gerente: Solo proyectos donde gerenteId == uid o en sus teamIds
    //    - Supervisor: Solo proyectos donde supervisorId/leadUserId == uid o en sus teamIds
    //    - Colaborador: Solo lectura donde uid esté en assignedToIds/assignedUserIds
    //      y actualización en cascada solo de tiempos acumulados
    // =========================================================
    match /projects/{projectId} {
      allow read: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data)) ||
        (isColaborador() && (
          isAssignedToProjectData(resource.data) ||
          sharesAnyTeam(resource.data)
        ))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(request.resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(request.resource.data))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data)) ||
        (isColaborador() &&
          isAssignedToProjectData(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loggedMinutes', 'actualHours', 'updatedAt']))
      );

      allow delete: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data))
      );
    }

    // =========================================================
    // 5. Colección `tasks/{taskId}` (Aislamiento Multi-Equipo + Cierre de Jornada)
    //    - RH: BLOQUEO ESTRICTO (false)
    //    - TI / Socio: Global
    //    - Gerente: Solo donde gerenteId == uid o en sus teamIds
    //    - Supervisor: Solo donde supervisorId == uid o en sus teamIds
    //    - Colaborador: Solo donde uid esté en assignedToIds o assignedToId == uid;
    //      permiso explícito para actualizar loggedMinutes/status al Confirmar Salida
    //      y crear tareas extraordinarias propias.
    // =========================================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data)) ||
        (isColaborador() && isAssignedToTaskData(resource.data))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(request.resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(request.resource.data)) ||
        (isColaborador() && isAssignedToTaskData(request.resource.data))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data)) ||
        (isColaborador() &&
          isAssignedToTaskData(resource.data) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loggedMinutes', 'status', 'completedAt', 'updatedAt']) ||
            resource.data.get('isExtraordinary', false) == true
          ))
      );

      allow delete: if isAuthenticated() && !isRH() && (
        isSocio() ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );
    }

    // =========================================================
    // 6. Colección `attendance/{attendanceId}` (Asistencias y Cierre de Jornada)
    //    - TI, Socio, RH: Lectura global
    //    - Gerente / Supervisor: Lectura de sus equipos y propios registros
    //    - Colaborador: Lectura, creación y actualización explícita de sus propios registros
    // =========================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isSocio() ||
        isRH() ||
        matchesUserRecord(resource.data) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );

      allow create: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        matchesUserRecord(request.resource.data)
      );

      allow update: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        matchesUserRecord(resource.data) ||
        matchesUserRecord(request.resource.data) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 7. Colección `time_logs/{logId}`
    //    - TI, Socio y RH: Lectura global (RH SOLO lectura, prohibido escribir)
    //    - Gerente / Supervisor: Lectura/escritura en su equipo
    //    - Colaborador: Lectura y registro de sus propios time_logs
    // =========================================================
    match /time_logs/{logId} {
      allow read: if isAuthenticated() && (
        isSocio() ||
        isRH() ||
        matchesUserRecord(resource.data) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isSocio() ||
        matchesUserRecord(request.resource.data) ||
        (isGerenteOnly() && isManagedByGerente(request.resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(request.resource.data))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isSocio() ||
        matchesUserRecord(resource.data) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );

      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    // =========================================================
    // 8. Colección `active_timers/{userId}`
    //    - Permiso explícito para que el Colaborador cree, actualice y BORRE
    //      su propio cronómetro al confirmar salida.
    // =========================================================
    match /active_timers/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        matchesUserRecord(request.resource.data) ||
        isSupervisor()
      );
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        matchesUserRecord(resource.data) ||
        isSupervisor()
      );
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        matchesUserRecord(resource.data) ||
        isSupervisor()
      );
    }

    // =========================================================
    // 9. Colección `checkins/{checkinId}` (Respaldo de Jornada)
    // =========================================================
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isSocio() ||
        isRH() ||
        matchesUserRecord(resource.data) ||
        (isGerenteOnly() && isManagedByGerente(resource.data)) ||
        (isSupervisorOnly() && isManagedBySupervisor(resource.data))
      );

      allow create: if isAuthenticated() && (
        isTI() ||
        matchesUserRecord(request.resource.data)
      );

      allow update: if isAuthenticated() && (
        isTI() ||
        matchesUserRecord(resource.data) ||
        matchesUserRecord(request.resource.data) ||
        isSupervisor()
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 10. Colección `invitations/{invitationId}` (Endurecida para Producción)
    //     - `update` CERRADO: requiere autenticación y que el correo invitado
    //       coincida estrictamente con `request.auth.token.email` (o mando autorizado).
    // =========================================================
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAuthenticated() && (
        isSupervisor() ||
        (getAuthEmailLower() != '' && safeLower(resource.data.get('email', '')) == getAuthEmailLower())
      );
      allow create: if isAuthenticated() && isSupervisor();
      allow update: if isAuthenticated() && (
        isSupervisor() ||
        (getAuthEmailLower() != '' &&
          safeLower(resource.data.get('email', '')) == getAuthEmailLower() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'registeredUserId', 'acceptedAt', 'acceptedUserId', 'acceptedByUid', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && isSupervisor();
    }

    // =========================================================
    // 11. Notificaciones y Bitácora de Auditoría
    // =========================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        resource.data.get('recipient_id', '') == request.auth.uid ||
        resource.data.get('recipient_id', '') == getEffectiveUid() ||
        resource.data.get('sender_id', '') == request.auth.uid ||
        resource.data.get('sender_id', '') == getEffectiveUid()
      );
      allow create: if isAuthenticated() && !isRH();
      allow update, delete: if isAuthenticated() && (
        isTI() ||
        resource.data.get('recipient_id', '') == request.auth.uid ||
        resource.data.get('recipient_id', '') == getEffectiveUid()
      );
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isGerente() || isRH());
      allow create: if isAuthenticated();
      allow update, delete: if isTI();
    }
  }
}
