rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Funciones Auxiliares de Autenticación y Matriz RBAC
    // =========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtener rol del token o del documento en users
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'colaborador');
    }

    function isTI() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'TI' || r == 'ti');
    }

    function isGerente() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Gerente' || r == 'gerente' || r == 'Socio' || r == 'socio' || isTI());
    }

    function isSupervisor() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Supervisor' || r == 'supervisor' || isGerente());
    }

    function isEmpleado() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'Empleado' || r == 'empleado' || r == 'Colaborador' || r == 'colaborador');
    }

    function isRH() {
      let r = getUserRole();
      return isAuthenticated() && (r == 'RH' || r == 'rh');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Permitir acceso prioritario y de inicialización a las cuentas base de prueba
    function isDemoAccount() {
      return request.auth.token.email != null && (
        request.auth.token.email.matches('.*\\.prueba@russellbedford\\.mx') ||
        request.auth.token.email == 'ti.root@russellbedford.mx'
      );
    }

    // Prohibición estricta de almacenar imágenes faciales base64 o binarias en el documento
    function hasNoBiometricImages(data) {
      return !('enrolledFacePhoto' in data) &&
             !('facePhotoUrl' in data) &&
             (!('biometrics' in data) || data.biometrics == null || (
               !('photo' in data.biometrics) &&
               !('image' in data.biometrics) &&
               !('base64' in data.biometrics)
             ));
    }

    // =========================================================
    // 1. Reglas para Usuarios (users)
    //    - TI / Cuentas demo: acceso total
    //    - Socio / Gerente / Supervisor: lectura de colaboradores
    //    - RH: lectura básica de personal para asistencias
    //    - Colaborador: su propio documento
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isSupervisor() ||
        isOwner(userId) ||
        isDemoAccount() ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid)
      );

      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        isTI() ||
        isSupervisor() ||
        isDemoAccount()
      );

      allow update: if hasNoBiometricImages(request.resource.data) && isAuthenticated() && (
        isTI() ||
        isSupervisor() ||
        isOwner(userId) ||
        isDemoAccount()
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 2. Reglas para Invitaciones Jerárquicas (invitations)
    // =========================================================
    match /invitations/{invitationId} {
      allow get: if true; // Lectura puntual para validar token de activación previo a registro
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (isTI() || isSupervisor());
      allow update: if true; // Consumo/invalidación del token
      allow delete: if isAuthenticated() && (isTI() || isSupervisor());
    }

    // =========================================================
    // 3. Regla para Tareas (tasks) - BLOQUEO TOTAL A RH
    // =========================================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        isSupervisor() ||
        (isEmpleado() && resource.data.assigned_to == request.auth.uid) ||
        resource.data.created_by == request.auth.uid ||
        isDemoAccount()
      );

      allow write: if isAuthenticated() && !isRH() && (
        isTI() ||
        isSupervisor() ||
        (isEmpleado() && (resource.data.assigned_to == request.auth.uid || request.resource.data.assigned_to == request.auth.uid)) ||
        isDemoAccount()
      );
    }

    // =========================================================
    // 4. Regla para Clientes (clients) - BLOQUEO TOTAL A RH
    // =========================================================
    match /clients/{clientId} {
      allow read: if isAuthenticated() && !isRH();
      allow write: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
    }

    // =========================================================
    // 5. Regla para Proyectos (projects) - BLOQUEO TOTAL A RH
    // =========================================================
    match /projects/{projectId} {
      allow read: if isAuthenticated() && !isRH();
      allow write: if isAuthenticated() && !isRH() && (isTI() || isSupervisor());
    }

    // =========================================================
    // 6. Regla para Registros de Tiempo (time_logs y checkins)
    //    - RH puede leer para generar Kardex y nómina
    //    - RH no puede escribir ni alterar tareas operativas
    // =========================================================
    match /time_logs/{logId} {
      allow read: if isAuthenticated() && (
        isTI() || isSupervisor() || isRH() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
      allow write: if isAuthenticated() && !isRH() && (
        isTI() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
    }

    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isTI() || isSupervisor() || isRH() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
      allow write: if isAuthenticated() && (
        isTI() || isSupervisor() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
    }

    // =========================================================
    // 7. Regla para Asistencia y Justificaciones (attendance)
    //    - RH, TI y Supervisor pueden gestionar y justificar checadas
    // =========================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isTI() || isSupervisor() || isRH() ||
        resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
      allow write: if isAuthenticated() && (
        isTI() || isSupervisor() || isRH() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isDemoAccount()
      );
    }

    // =========================================================
    // 8. Bitácora Ejecutiva de Auditoría (audit_logs)
    //    - Autorizado a TI, Socio, Gerente y RH
    // =========================================================
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isTI() || isGerente() || isRH() || isDemoAccount());
      allow write: if isAuthenticated();
    }

    // =========================================================
    // 9. Notificaciones Internas (notifications) - BLOQUEO A RH
    // =========================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        resource.data.recipient_id == request.auth.uid ||
        resource.data.sender_id == request.auth.uid ||
        isDemoAccount()
      );
      allow create: if isAuthenticated() && !isRH();
      allow update: if isAuthenticated() && (
        resource.data.recipient_id == request.auth.uid || isTI()
      );
      allow delete: if isAuthenticated() && (
        resource.data.recipient_id == request.auth.uid || isTI()
      );
    }

    // =========================================================
    // 10. Equipos y Estructura Organizacional (teams)
    // =========================================================
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isTI() || isSupervisor() || isDemoAccount());
    }

    // =========================================================
    // 11. Cronómetros en Tiempo Vivo (active_timers)
    // =========================================================
    match /active_timers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isOwner(userId) || isTI() || isSupervisor() || isDemoAccount()
      );
    }
  }
}
