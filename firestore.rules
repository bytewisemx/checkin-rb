rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Jerarquía Corporativa Oficial y Funciones Auxiliares RBAC:
    // Nivel 0: TI (Root - Administración Total)
    // Nivel 1: Socio (Máxima Autoridad Operativa)
    // Nivel 2: Gerente (Línea Operativa) || RH (Lateral - Solo Asistencias/Tiempos)
    // Nivel 3: Supervisor (Reporta a Gerente)
    // Nivel 4: Colaborador (Base Operativa - Reporta a Supervisor)
    //
    // Optimización crítica:
    // - Cero llamadas `get()`/`exists()` en cascada (evita exceder límite de 10 lecturas)
    // - Cero `.lower()` sin verificar `is string` (evita crashes silenciosos por null)
    // =========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function safeLower(val) {
      return val is string ? val.lower() : '';
    }

    function getAuthEmailLower() {
      return isAuthenticated() && 'email' in request.auth.token
        ? safeLower(request.auth.token.email)
        : '';
    }

    function getDemoDocIdByEmail() {
      let em = getAuthEmailLower();
      return em == 'ti.root@russellbedford.mx' ? 'demo_ti'
        : em == 'socio.prueba@russellbedford.mx' ? 'demo_socio'
        : em == 'gerente.prueba@russellbedford.mx' ? 'demo_gerente'
        : em == 'rh.prueba@russellbedford.mx' ? 'demo_rh'
        : em == 'supervisor.prueba@russellbedford.mx' ? 'demo_supervisor'
        : em == 'colaborador.prueba@russellbedford.mx' ? 'demo_colaborador'
        : '';
    }

    function getDemoRoleByEmail() {
      let em = getAuthEmailLower();
      return em == 'ti.root@russellbedford.mx' ? 'ti'
        : em == 'socio.prueba@russellbedford.mx' ? 'socio'
        : em == 'gerente.prueba@russellbedford.mx' ? 'gerente'
        : em == 'rh.prueba@russellbedford.mx' ? 'rh'
        : em == 'supervisor.prueba@russellbedford.mx' ? 'supervisor'
        : em == 'colaborador.prueba@russellbedford.mx' ? 'colaborador'
        : '';
    }

    function getEffectiveUid() {
      let demoId = getDemoDocIdByEmail();
      return demoId != '' ? demoId : request.auth.uid;
    }

    // Resuelve el rol en minúsculas con 0 lecturas para cuentas demo y máx. 1 lectura para usuarios reales
    function getUserRoleLower() {
      let demoRole = getDemoRoleByEmail();
      return demoRole != ''
        ? demoRole
        : ('role' in request.auth.token && request.auth.token.role is string
            ? request.auth.token.role.lower()
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? safeLower(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'colaborador'))
                : 'colaborador'));
    }

    function getUserTeamId() {
      let effUid = getEffectiveUid();
      return exists(/databases/$(database)/documents/users/$(effUid))
        ? get(/databases/$(database)/documents/users/$(effUid)).data.get('teamId', null)
        : null;
    }

    // Roles sin cascada (máx. 1 evaluación de getUserRoleLower por llamada)
    function isTI() {
      return isAuthenticated() && getUserRoleLower() == 'ti';
    }

    function isSocio() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio'];
    }

    function isGerente() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio', 'gerente'];
    }

    function isSupervisor() {
      return isAuthenticated() && getUserRoleLower() in ['ti', 'socio', 'gerente', 'supervisor'];
    }

    function isRH() {
      return isAuthenticated() && getUserRoleLower() == 'rh';
    }

    function isEmpleado() {
      return isAuthenticated() && getUserRoleLower() in ['empleado', 'colaborador'];
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        getEffectiveUid() == userId
      );
    }

    function isDemoAccount() {
      let em = getAuthEmailLower();
      return em != '' && (
        em.matches('.*\\.prueba@russellbedford\\.mx') ||
        em == 'ti.root@russellbedford.mx'
      );
    }

    function matchesUserRecord(data) {
      let effUid = getEffectiveUid();
      let em = getAuthEmailLower();
      return data != null && (
        data.get('userId', '') == request.auth.uid ||
        data.get('userId', '') == effUid ||
        (em != '' && safeLower(data.get('userEmail', '')) == em) ||
        (em != '' && safeLower(data.get('email', '')) == em)
      );
    }

    function isAssignedToTaskData(data) {
      let effUid = getEffectiveUid();
      let em = getAuthEmailLower();
      return data != null && (
        data.get('assignedToId', '') == request.auth.uid ||
        data.get('assignedToId', '') == effUid ||
        data.get('assignedTo', '') == request.auth.uid ||
        data.get('assignedTo', '') == effUid ||
        data.get('assigned_to', '') == request.auth.uid ||
        data.get('assigned_to', '') == effUid ||
        (em != '' && safeLower(data.get('assignedToEmail', '')) == em)
      );
    }

    // Prohibición estricta de imágenes faciales; solo vector numérico 128-D
    function hasNoBiometricImages(data) {
      return !('enrolledFacePhoto' in data) &&
             !('facePhotoUrl' in data) &&
             (!('faceDescriptor' in data) || data.faceDescriptor == null || (data.faceDescriptor is list && data.faceDescriptor.size() == 128)) &&
             (!('biometrics' in data) || data.biometrics == null || (
               !('photo' in data.biometrics) &&
               !('image' in data.biometrics) &&
               !('base64' in data.biometrics)
             ));
    }

    // =========================================================
    // 1. Colección `users` (Cadena de Mando y Permisos)
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isTI() ||
        isSocio() ||
        isRH() ||
        isOwner(userId) ||
        isDemoAccount() ||
        (isGerente() && (
          resource.data.get('gerenteId', '') == request.auth.uid ||
          resource.data.get('gerenteId', '') == getEffectiveUid() ||
          resource.data.get('managerId', '') == request.auth.uid ||
          resource.data.get('managerId', '') == getEffectiveUid() ||
          (getUserTeamId() != null && resource.data.get('teamId', '') == getUserTeamId())
        )) ||
        (isSupervisor() && (
          resource.data.get('supervisorId', '') == request.auth.uid ||
          resource.data.get('supervisorId', '') == getEffectiveUid() ||
          resource.data.get('supervisor_id', '') == request.auth.uid ||
          resource.data.get('supervisor_id', '') == getEffectiveUid() ||
          (getUserTeamId() != null && resource.data.get('teamId', '') == getUserTeamId())
        )) ||
        (getAuthEmailLower() != '' && safeLower(resource.data.get('email', '')) == getAuthEmailLower()) ||
        resource.data.get('uid', '') == request.auth.uid
      );

      allow create: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        isDemoAccount() ||
        isOwner(userId)
      );

      allow update: if isAuthenticated() && hasNoBiometricImages(request.resource.data) && (
        isTI() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules', 'hierarchyLevel'])) ||
        (isDemoAccount() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'modules']))
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 2. Colecciones `companies` y `clients` (Empresas / Clientes)
    //    - TI, Socio, Gerente: creación y gestión de empresas/clientes
    //    - Supervisor y Colaborador: lectura operativa (nombre/logotipo en proyectos)
    //    - RH (Nivel 2 Lateral): BLOQUEO ESTRICTO (403)
    // =========================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated() && !isRH();
      allow create, update: if isAuthenticated() && !isRH() && isGerente();
      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && !isRH();
      allow create, update: if isAuthenticated() && !isRH() && isGerente();
      allow delete: if isAuthenticated() && !isRH() && isSocio();
    }

    // =========================================================
    // 3. Colección `tasks` (Tareas y Tiempos en minutos enteros)
    //    - Socio / TI / Gerente: Global
    //    - Supervisor: Su línea jerárquica
    //    - Colaborador: Lee sus tareas asignadas, actualiza tiempo invertido / estado
    //      al cerrar jornada y puede registrar tareas extraordinarias propias
    //    - RH (Nivel 2 Lateral): BLOQUEO ESTRICTO (403)
    // =========================================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && !isRH() && (
        isGerente() ||
        (isSupervisor() && (
          isDemoAccount() ||
          resource.data.get('supervisorId', '') == request.auth.uid ||
          resource.data.get('supervisorId', '') == getEffectiveUid() ||
          resource.data.get('created_by', '') == request.auth.uid ||
          resource.data.get('created_by', '') == getEffectiveUid() ||
          (getUserTeamId() != null && resource.data.get('teamId', '') == getUserTeamId())
        )) ||
        (isEmpleado() && (
          isDemoAccount() ||
          isAssignedToTaskData(resource.data)
        ))
      );

      allow create: if isAuthenticated() && !isRH() && (
        isSupervisor() ||
        (isEmpleado() && (
          isDemoAccount() ||
          isAssignedToTaskData(request.resource.data) ||
          request.resource.data.get('isExtraordinary', false) == true
        ))
      );

      allow update: if isAuthenticated() && !isRH() && (
        isSupervisor() ||
        (isEmpleado() && (
          isDemoAccount() ||
          isAssignedToTaskData(resource.data) ||
          isAssignedToTaskData(request.resource.data) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loggedMinutes', 'status', 'completedAt', 'updatedAt'])
        ))
      );

      allow delete: if isAuthenticated() && !isRH() && isSupervisor();
    }

    // =========================================================
    // 4. Colección `projects` - BLOQUEO ESTRICTO A RH (403)
    //    - Colaborador: lectura y actualización en cascada solo de tiempos acumulados
    // =========================================================
    match /projects/{projectId} {
      allow read: if isAuthenticated() && !isRH();
      allow create, delete: if isAuthenticated() && !isRH() && isSupervisor();
      allow update: if isAuthenticated() && !isRH() && (
        isSupervisor() ||
        (isEmpleado() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loggedMinutes', 'actualHours', 'updatedAt']))
      );
    }

    // =========================================================
    // 5. Colección `attendance` (Asistencias, Biometría y Tiempos)
    //    - TI, Socio, Gerente y RH: Lectura consolidada
    //    - Supervisor: Su línea/equipo
    //    - Colaborador: Crea y actualiza sus propios registros (UID real o demo_*)
    // =========================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isGerente() ||
        isRH() ||
        isDemoAccount() ||
        (isSupervisor() && getUserTeamId() != null && resource.data.get('teamId', '') == getUserTeamId()) ||
        matchesUserRecord(resource.data)
      );

      allow create: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isDemoAccount() ||
        matchesUserRecord(request.resource.data)
      );

      allow update: if isAuthenticated() && (
        isTI() ||
        isRH() ||
        isSupervisor() ||
        isDemoAccount() ||
        matchesUserRecord(resource.data) ||
        matchesUserRecord(request.resource.data)
      );

      allow delete: if isTI();
    }

    // =========================================================
    // 6. Colecciones Operativas Complementarias
    // =========================================================
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isSupervisor() || isRH() || isDemoAccount() ||
        matchesUserRecord(resource.data)
      );
      allow create: if isAuthenticated() && (
        isSupervisor() || isDemoAccount() ||
        matchesUserRecord(request.resource.data)
      );
      allow update: if isAuthenticated() && (
        isSupervisor() || isDemoAccount() ||
        matchesUserRecord(resource.data) ||
        matchesUserRecord(request.resource.data)
      );
      allow delete: if isTI();
    }

    match /time_logs/{logId} {
      allow read: if isAuthenticated() && (
        isSupervisor() || isRH() || isDemoAccount() ||
        matchesUserRecord(resource.data)
      );
      allow create: if isAuthenticated() && !isRH() && (
        isSupervisor() || isDemoAccount() ||
        matchesUserRecord(request.resource.data)
      );
      allow update: if isAuthenticated() && !isRH() && (
        isSupervisor() || isDemoAccount() ||
        matchesUserRecord(resource.data) ||
        matchesUserRecord(request.resource.data)
      );
      allow delete: if isAuthenticated() && !isRH() && isSupervisor();
    }

    match /active_timers/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isOwner(userId) ||
        isSupervisor() ||
        isDemoAccount() ||
        matchesUserRecord(resource != null ? resource.data : null) ||
        matchesUserRecord(request.resource != null ? request.resource.data : null)
      );
    }

    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isSupervisor();
      allow update: if true;
      allow delete: if isAuthenticated() && isSupervisor();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isSupervisor() || isDemoAccount());
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && !isRH() && (
        isTI() ||
        isDemoAccount() ||
        resource.data.get('recipient_id', '') == request.auth.uid ||
        resource.data.get('recipient_id', '') == getEffectiveUid() ||
        resource.data.get('sender_id', '') == request.auth.uid ||
        resource.data.get('sender_id', '') == getEffectiveUid()
      );
      allow create: if isAuthenticated() && !isRH();
      allow update, delete: if isAuthenticated() && (
        isTI() ||
        isDemoAccount() ||
        resource.data.get('recipient_id', '') == request.auth.uid ||
        resource.data.get('recipient_id', '') == getEffectiveUid()
      );
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isGerente() || isRH() || isDemoAccount());
      allow write: if isAuthenticated();
    }
  }
}
